{
  "name": "@promimi/infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./database": { "types": "./src/database/index.ts", "default": "./dist/database/index.js" },
    "./database/schema": { "types": "./src/database/schema/index.ts", "default": "./dist/database/schema/index.js" },
    "./config": { "types": "./src/config/index.ts", "default": "./dist/config/index.js" },
    "./config/admin": { "types": "./src/config/admin.ts", "default": "./dist/config/admin.js" },
    "./config/api": { "types": "./src/config/api.ts", "default": "./dist/config/api.js" },
    "./config/database": { "types": "./src/config/database.ts", "default": "./dist/config/database.js" },
    "./config/mobile": { "types": "./src/config/mobile.ts", "default": "./dist/config/mobile.js" },
    "./config/whatsapp": { "types": "./src/config/whatsapp.ts", "default": "./dist/config/whatsapp.js" },
    "./config/worker": { "types": "./src/config/worker.ts", "default": "./dist/config/worker.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "check": "drizzle-kit check",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.2",
    "pg": "^8.16.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
