{
  "name": "promimi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "pnpm typecheck",
    "test": "turbo test",
    "verify": "pnpm --filter @promimi/database check && pnpm lint && pnpm test && pnpm build",
    "test:acceptance": "bash scripts/acceptance.sh",
    "db:generate": "pnpm --filter @promimi/database generate",
    "db:migrate": "pnpm --filter @promimi/database migrate",
    "db:seed": "pnpm --filter @promimi/database seed"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prettier": "^3.5.3",
    "turbo": "^2.5.2",
    "typescript": "^5.8.3"
  }
}
