FROM node:22-bookworm
RUN corepack enable && apt-get update && apt-get install -y --no-install-recommends chromium ca-certificates && rm -rf /var/lib/apt/lists/*
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile=false
CMD ["pnpm", "--filter", "@promimi/whatsapp", "exec", "tsx", "src/main.ts"]
